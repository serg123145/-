rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products collection: public read and write
    match /products/{productId} {
      allow read, write: if true;
    }
    
    // Orders collection: public create/read/update for owner & customer
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Store Info & Settings document: public read and write
    match /store_info/{docId} {
      allow read, write: if true;
    }

    // Reviews collection: public read and write
    match /reviews/{reviewId} {
      allow read, write: if true;
    }
  }
}
